# Generated by terraform/aws — Ansible runs on the control node.
# Use these PRIVATE IPs. Copy the matching private key to /home/ubuntu/keys/homelab-ec2.pem

[web]
web1 ansible_host=${web_private_ip}

[app]
web1

[db]
db1 ansible_host=${db_private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/home/ubuntu/keys/homelab-ec2.pem
ansible_python_interpreter=/usr/bin/python3
homelab_web_ip=${web_private_ip}
homelab_app_ip=127.0.0.1
homelab_db_ip=${db_private_ip}
nginx_health_host=${web_private_ip}
db_listen_addresses=${db_private_ip},127.0.0.1
lab_mode=true
